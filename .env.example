# ==============================================================================
# Zolexora TMS — Environment Variables Reference
# ==============================================================================
#
# HOW ENV FILES WORK IN THIS REPO
# ────────────────────────────────
# .env          Encrypted by dotenvx. Committed to git. Contains all secrets.
#               Decrypted at runtime via DOTENV_PRIVATE_KEY.
# .env.keys     dotenvx private key. NEVER commit. Gitignored.
# .env.local    Plain-text local overrides. NEVER commit. Gitignored.
#               Used by local-start.sh to unlock Bitwarden on a fresh machine.
# .env.example  This file. Safe to commit. No real secrets — placeholders only.
#
# SETUP FOR A NEW DEVELOPER
# ─────────────────────────
# 1. Create .env.local with your Bitwarden credentials (see section 0 below).
# 2. Run: bash scripts/local-start.sh
#    The script fetches DOTENV_PRIVATE_KEY from Bitwarden and decrypts .env
#    automatically — no manual key management needed.
# ==============================================================================

# ==============================================================================
# 0. LOCAL MACHINE SECRETS  →  goes in .env.local (DO NOT COMMIT)
# ==============================================================================
# BW_CLIENTID=user.xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx
# BW_CLIENTSECRET=your_bw_client_secret_here
# BW_MASTER_PASSWORD=your_bitwarden_master_password_here
# SCOPE=api
# GRANT_TYPE=client_credentials

# ==============================================================================
# 1. CORE APP RUNTIME & PORTS
# ==============================================================================
NODE_ENV=development
PORT=8000                                    # Backend API (FastAPI/uvicorn)
NEXT_PUBLIC_APP_URL=http://localhost:3000    # TMS Frontend
NEXT_PUBLIC_ADMIN_URL=http://localhost:3001  # Admin Dashboard

# ==============================================================================
# 2. DATABASE
# ==============================================================================
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/zolexora_tms
POSTGRES_USER=your_postgres_user_here
POSTGRES_PASSWORD=your_postgres_password_here
POSTGRES_DB=your_postgres_db_here
POSTGRES_PORT=5432

# ==============================================================================
# 3. SUPABASE (AUTH & DATABASE)
# ==============================================================================
SUPABASE_URL=https://your_project_ref.supabase.co
SUPABASE_PROJECT_REF=your_supabase_project_ref_here
SUPABASE_ANON_KEY=your_supabase_anon_key_here
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key_here
NEXT_PUBLIC_SUPABASE_URL=https://your_project_ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_next_public_supabase_anon_key_here

# ==============================================================================
# 4. APPLICATION SECURITY
# ==============================================================================
JWT_SECRET=your_jwt_secret_here
SESSION_SECRET=your_session_secret_here
WEBHOOK_SECRET=your_webhook_secret_here

# ==============================================================================
# 5. RESEND (TRANSACTIONAL EMAIL)
# ==============================================================================
RESEND_API_KEY=your_resend_api_key_here

# ==============================================================================
# 6. CLOUDINARY (MEDIA MANAGEMENT)
# ==============================================================================
CLOUDINARY_CLOUD_NAME=your_cloudinary_cloud_name_here
CLOUDINARY_URL=cloudinary://your_api_key:your_api_secret@your_cloud_name
NEXT_PUBLIC_CLOUDINARY_CLOUD_NAME=your_cloudinary_cloud_name_here

# ==============================================================================
# 7. CLOUDFLARE (R2 STORAGE & WORKERS)
# ==============================================================================
CLOUDFLARE_ACCOUNT_ID=your_cloudflare_account_id_here
CLOUDFLARE_API_TOKEN=your_cloudflare_api_token_here
CLOUDFLARE_R2_ACCESS_KEY=your_r2_access_key_here
CLOUDFLARE_R2_SECRET_KEY=your_r2_secret_key_here
CLOUDFLARE_R2_BUCKET=zolexora-assets

# ==============================================================================
# 8. PAYMENT GATEWAY (CASHFREE)
# ==============================================================================
CASHFREE_APP_ID=your_cashfree_app_id_here
CASHFREE_SECRET_KEY=your_cashfree_secret_key_here
CASHFREE_ENV=TEST   # TEST or PROD

# ==============================================================================
# 9. BACKGROUND TASKS
# ==============================================================================
REDIS_URL=redis://localhost:6379/0

# ==============================================================================
# 10. OBSERVABILITY
# ==============================================================================
SENTRY_DSN=your_sentry_dsn_here

# ==============================================================================
# 11. RENDER (DEPLOYMENT — only needed for CI/CD or manual deploys)
# ==============================================================================
RENDER_API_KEY=your_render_api_key_here
RENDER_WORKSPACE_ID=your_render_workspace_id_here
