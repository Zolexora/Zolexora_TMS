# Copy to .env for local development. On Render, set these as service
# Environment Variables instead (see render.yaml) -- never commit a real
# .env file.

APP_ENV=development

# --- Supabase (masters + auth) ---------------------------------------------
# Supabase dashboard -> Settings -> API
SUPABASE_URL=https://your-project-ref.supabase.co
# Supabase dashboard -> Settings -> Database -> Connection string (URI).
# Use the "Session pooler" connection for a long-running server like this
# one (Render web services are long-running, not per-request serverless).
SUPABASE_DB_URL=postgresql://postgres.your-project-ref:password@aws-0-region.pooler.supabase.com:5432/postgres

# Verification is JWKS-based by default (derived automatically from
# SUPABASE_URL). Only set these if your project has NOT migrated to
# asymmetric JWT Signing Keys yet (Supabase dashboard -> Settings -> API ->
# JWT Settings will tell you):
# SUPABASE_JWKS_URL=
# SUPABASE_JWT_SECRET=

# Used only for the Auth Admin API (not needed for normal request handling
# today, reserved for future admin tooling). Supabase dashboard -> Settings
# -> API -> the "secret" key (or legacy service_role key).
SUPABASE_SERVICE_KEY=

# --- Cloudflare D1 (transactional data) -------------------------------------
D1_ACCESS_MODE=gateway
# The Worker URL from `wrangler deploy` in ../cloudflare-d1-gateway
D1_GATEWAY_URL=https://zolexora-d1-gateway.your-subdomain.workers.dev
# Must match the GATEWAY_TOKEN secret set via `wrangler secret put GATEWAY_TOKEN`
D1_GATEWAY_TOKEN=

# Only used if D1_ACCESS_MODE=direct_admin_api (not recommended, see README)
CF_ACCOUNT_ID=
CF_D1_DATABASE_ID=
CF_API_TOKEN=

# --- App-level ---------------------------------------------------------------
# Comma-separated list of allowed frontend origins.
CORS_ALLOWED_ORIGINS=http://localhost:3000,https://your-frontend-domain.com
