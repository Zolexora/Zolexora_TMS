# Copy this file to .env for local development, or set these as build-time
# environment variables in whatever host serves the built frontend
# (Cloudflare Pages, Vercel, Netlify, etc.) All VITE_* variables are baked
# into the JS bundle at build time -- they are public and must never hold
# secrets (the anon key below is meant to be public; see Supabase's docs).

# Supabase dashboard -> Settings -> API
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-or-publishable-key

# Your deployed Render backend URL. Leave blank for local development if you
# want Vite's dev-server proxy (see vite.config.ts) to forward /api requests
# to a FastAPI instance running locally on http://localhost:8000.
VITE_API_BASE_URL=https://your-backend.onrender.com
