{
  "name": "zolexora-tms",
  "private": true,
  "version": "0.1.0",
  "packageManager": "pnpm@11.24.0",
  "scripts": {
    "docker:start": "bash scripts/docker-start.sh start",
    "docker:stop": "bash scripts/docker-start.sh stop",
    "build:tms": "pnpm --filter zolexora-tms run build",
    "build:admin": "pnpm --filter zolexora-tms-admin run build",
    "dev:tms": "pnpm --filter zolexora-tms run dev",
    "dev:admin": "pnpm --filter zolexora-tms-admin run dev",
    "test:backend": "apps/backend/.venv/bin/pytest apps/backend/tests/",
    "cli:check": "bash scripts/setup-cli-ecosystem.sh --check",
    "cli:setup": "bash scripts/setup-cli-ecosystem.sh",
    "cli:docs": "bash scripts/setup-cli-ecosystem.sh --docs",
    "ecosystem:check": "bash scripts/setup-cli-ecosystem.sh --check",
    "ecosystem:setup": "bash scripts/setup-cli-ecosystem.sh",
    "ecosystem:docs": "bash scripts/setup-cli-ecosystem.sh --docs"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.116.0"
  }
}
